{
  "version": 2,
  "builds": [
    {
      "src": "client/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    },
    {
      "src": "server/index.js",
      "use": "@vercel/node",
      "config": {
        "maxDuration": 60
      }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "server/index.js"
    },
    {
      "src": "^/game$",
      "status": 308,
      "headers": {
        "Location": "/game/index.html"
      }
    },
    {
      "src": "^/game/$",
      "dest": "client/game/index.html"
    },
    {
      "src": "/(.*)",
      "dest": "client/$1"
    }
  ]
}
